{
  "repo_id": "zsl1_demo",
  "fps": 30,
  "hand_dim": 0,
  "leg_dim": 16,
  "lcm_enabled": false,
  "dataset_root": "/home/hp/data/hf_dataset",
  "ros2": {
    "enabled": true,
    "topics": [
      {
        "topic": "/joint_states",
        "type": "JointState",
        "target": "joint.state",
        "field": "position"
      },
      {
        "topic": "/joint_state_cmd",
        "type": "JointState",
        "target": "joint.cmd",
        "field": "position"
      }
    ]
  },
  "dataset_fields": {
    "observation.joint.position": {
      "source": "joint.state",
      "dim": 16
    },
    "observation.joint.cmd": {
      "source": "joint.cmd",
      "dim": 16
    }
  }
}
